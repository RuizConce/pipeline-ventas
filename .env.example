# Base de datos MySQL (Railway)
DB_HOST=your-mysql-host.railway.internal
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your-password

# Google Places API (para scraper/google_maps.py — sin esto el scraper no funciona)
# Activar en: https://console.cloud.google.com/ → APIs → "Places API (New)"
# Costo: $200 crédito/mes gratis = ~5 000 búsquedas gratuitas
GOOGLE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend email API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=ventas@conectacsur.cl

# Instagram scraper (opcional — sin esto el scraper corre sin sesión)
IG_USERNAME=tu_usuario_instagram
IG_PASSWORD=tu_contraseña_instagram

# Servidor CRM
PORT=3001
